# Copy to .env and fill in. Never commit .env.
# On Streamlit Cloud these go in the Secrets panel instead of a file.

# https://developer.adzuna.com/ - free tier
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# https://aistudio.google.com/apikey - free tier
GEMINI_API_KEY=

# Bundesagentur für Arbeit and Arbeitnow need no credentials.
# Bundesagentur uses a fixed public header value, set in src/fetcher.py.
